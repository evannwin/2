<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="showcase__row{% cycle '', ' showcase__row--flip' %}" {{ block.shopify_attributes }}>
        <div class="showcase__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="
                {{ block.settings.image | image_url: width: 400 }} 400w,
                {{ block.settings.image | image_url: width: 800 }} 800w
              "
              sizes="(min-width: 900px) 50vw, 100vw"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="showcase__content">
          {%- if block.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank -%}
            <a class="link-arrow" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }} &rarr;</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Designed for daily relief"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everywhere your day takes you"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Image + text row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Lifestyle photo, recommended 1000 × 800px."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "At your desk"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Drape it over your shoulders during that one meeting that could have been an email. The cross-straps keep both hands free."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "eyebrow": "On the sofa",
            "title": "Your nightly wind-down",
            "text": "Fifteen minutes with heat on while you watch your show. Most customers say this is when they feel their shoulders finally drop."
          }
        },
        {
          "type": "row",
          "settings": {
            "eyebrow": "At your desk",
            "title": "Between back-to-back calls",
            "text": "The wearable cross-strap design means you can keep typing while the nodes work through your trapezius."
          }
        },
        {
          "type": "row",
          "settings": {
            "eyebrow": "Two colorways",
            "title": "Cloud White or Stone Grey",
            "text": "A finish that looks at home on your shelf — not like gym equipment you need to hide when guests come over."
          }
        }
      ]
    }
  ]
}
{% endschema %}
