{%- comment -%}
  Uses Shopify's Product Recommendations API. On first render the section is
  empty; theme.js fetches this same section with ?section_id and swaps in the
  recommendation results.
{%- endcomment -%}

<section
  class="scheme-{{ section.settings.scheme }} section-pad"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
>
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      <div class="page-width">
        <p class="eyebrow" style="margin-bottom: 2.5rem;">{{ section.settings.heading }}</p>
        <div class="product-grid">
          {%- for recommended in recommendations.products -%}
            {% render 'product-card', product: recommended %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "taupe", "label": "Taupe" },
        { "value": "cream", "label": "Cream" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
