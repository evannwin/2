{%- comment -%}
  Fallback cart page. Most visitors use the slide-out drawer;
  this page exists for /cart direct visits and no-JS users.
{%- endcomment -%}
<div class="container cart-page">
  <h1>Your cart</h1>

  {%- if cart.item_count == 0 -%}
    <p>Your cart is empty.</p>
    <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      {%- for item in cart.items -%}
        <div class="cart-line">
          <div class="cart-line__media">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy" width="96" height="96">
            {%- endif -%}
          </div>
          <div class="cart-line__info">
            <p class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
            {%- unless item.product.has_only_default_variant -%}
              <p class="cart-line__variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="cart-line__controls">
              <div class="qty">
                <button type="button" data-qty-change="down" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
                <button type="button" data-qty-change="up" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
              </div>
              <div class="cart-line__price">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}

      <div class="cart-page__footer">
        <div class="drawer__subtotal">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="drawer__tax-note">Shipping and taxes calculated at checkout.</p>
        <button type="submit" name="update" class="btn btn--secondary btn--full" style="margin-bottom: 1rem;">Update cart</button>
        <button type="submit" name="checkout" class="btn btn--primary btn--large btn--full">
          {% render 'icon', name: 'lock' %} Checkout securely
        </button>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
