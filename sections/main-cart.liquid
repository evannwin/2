<section class="scheme-taupe section-pad">
  <div class="page-width" style="max-width: 56rem;">
    <h1 class="display-lg" style="margin-bottom: 2.5rem;">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart -%}
        <table class="cart-table">
          <thead>
            <tr>
              <th colspan="2">{{ 'products.product.price' | t }}</th>
              <th>{{ 'products.product.quantity' | t }}</th>
              <th style="text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td style="width: 88px;">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 144 | image_tag: loading: 'lazy', alt: item.title | escape }}
                  {%- endif -%}
                </td>
                <td>
                  <p style="font-family: var(--font-heading); font-size: 1.0625rem;">{{ item.product.title }}</p>
                  {%- unless item.product.has_only_default_variant -%}
                    <p style="font-size: 0.8125rem; opacity: 0.75;">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  <p style="font-size: 0.8125rem; opacity: 0.75;">{{ item.final_price | money }}</p>
                  <a href="{{ item.url_to_remove }}" style="font-size: 0.75rem; text-decoration: underline;">
                    {{ 'cart.general.remove' | t }}
                  </a>
                </td>
                <td style="width: 6.5rem;">
                  <label class="visually-hidden" for="Qty-{{ item.index | plus: 1 }}">{{ 'products.product.quantity' | t }}</label>
                  <input
                    id="Qty-{{ item.index | plus: 1 }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    style="width: 5rem; padding: 0.5rem 0.75rem; background: transparent; border: 1px solid var(--s-line); border-radius: 999px; color: inherit;"
                  >
                </td>
                <td style="text-align: right;">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2rem;">
          <div>
            <p class="eyebrow">{{ 'cart.general.subtotal' | t }} — {{ cart.total_price | money }}</p>
            <p style="font-size: 0.8125rem; opacity: 0.7; margin-top: 0.375rem;">{{ 'cart.general.taxes_and_shipping' | t }}</p>
          </div>
          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn-pill btn-pill--outline" name="update">
              {{ 'cart.general.update' | t }}
            </button>
            <button type="submit" class="btn-pill" name="checkout">
              {{ 'cart.general.checkout' | t }}
              <span class="btn-pill__icon">{% render 'icons', icon: 'arrow-right' %}</span>
            </button>
          </div>
        </div>
      {%- endform -%}
    {%- else -%}
      <p class="body-copy" style="margin-bottom: 2rem;">{{ 'cart.general.empty' | t }}</p>
      <a class="btn-pill" href="{{ routes.all_products_collection_url }}">
        {{ 'cart.general.continue_shopping' | t }}
        <span class="btn-pill__icon">{% render 'icons', icon: 'arrow-right' %}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
