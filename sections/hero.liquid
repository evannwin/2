<section class="hero" id="HomeHero">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero__sub">{{ section.settings.subheading }}</p>
        <div class="hero__ctas">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn btn--primary btn--large" href="{{ section.settings.cta_link | default: '#' }}">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="link-arrow" href="{{ section.settings.secondary_link | default: '#' }}">
              {{ section.settings.secondary_label }} &rarr;
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.note != blank -%}
          <p class="hero__note">
            {% render 'icon', name: 'check-circle' %}
            {{ section.settings.note }}
          </p>
        {%- endif -%}
      </div>
      <div class="hero__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="
              {{ section.settings.image | image_url: width: 450 }} 450w,
              {{ section.settings.image | image_url: width: 750 }} 750w,
              {{ section.settings.image | image_url: width: 1100 }} 1100w
            "
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "For desk-job necks and heavy shoulders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Melt away neck tension in 15 minutes a day"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Somora's deep-kneading massager works like a masseuse's thumbs on your neck and shoulders — at home, whenever the knots show up."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get relief — $75.99"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Point this at your product page."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "See how it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Reassurance note",
      "default": "30-night home trial · Free returns"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Lifestyle shot of the massager in use converts best. Recommended 1200 × 1000px."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
