<section class="scheme-{{ section.settings.scheme }} section-pad">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" style="margin-bottom: 2.5rem;">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <blockquote class="testimonials__cell" {{ block.shopify_attributes }}>
          {% render 'brand-mark' %}
          <p class="testimonials__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <footer class="testimonials__author">
            <p class="eyebrow">{{ block.settings.author }}</p>
          </footer>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section eyebrow",
      "default": "What people say"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "taupe", "label": "Taupe" },
        { "value": "cream", "label": "Cream" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Ten minutes in the evening and the knot I've carried for years just isn't there anymore."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Mara T. — Verified buyer"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Ten minutes in the evening and the knot I've carried for years just isn't there anymore.", "author": "Mara T. — Verified buyer" } },
        { "type": "quote", "settings": { "quote": "It feels less like a gadget and more like a ritual. The warmth alone is worth it.", "author": "Jonas K. — Verified buyer" } },
        { "type": "quote", "settings": { "quote": "I sit at a desk all day. This is the first thing that's actually changed how my shoulders feel.", "author": "Priya S. — Verified buyer" } }
      ]
    }
  ]
}
{% endschema %}
