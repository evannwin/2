{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign threshold = section.settings.low_stock_threshold
-%}

<div class="container" data-product-root>
  <div class="product__grid">

    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="product__gallery">
      <div class="gallery__main">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div
              class="gallery__slide"
              data-media-id="{{ media.id }}"
              data-zoom-src="{{ media | image_url: width: 1800 }}"
            >
              <img
                src="{{ media | image_url: width: 800 }}"
                srcset="
                  {{ media | image_url: width: 400 }} 400w,
                  {{ media | image_url: width: 800 }} 800w,
                  {{ media | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 990px) 55vw, 100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="gallery__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button class="gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" aria-label="View image {{ forloop.index }}">
              <img
                src="{{ media | image_url: width: 150 }}"
                alt=""
                loading="lazy"
                width="64"
                height="64"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="buybox">
      {%- if section.settings.show_rating -%}
        <a class="buybox__rating" href="#Reviews">
          {% render 'stars', rating: section.settings.rating_value %}
          <span>{{ section.settings.rating_text }}</span>
        </a>
      {%- endif -%}

      <h1>{{ product.title }}</h1>

      <div class="price">
        <span class="price__current" data-price-current>{{ current_variant.price | money }}</span>
        <s
          class="price__compare"
          data-price-compare
          {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
        >{{ current_variant.compare_at_price | money }}</s>
        {%- liquid
          assign save_pct = 0
          if current_variant.compare_at_price > current_variant.price
            assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
          endif
        -%}
        <span
          class="price__save"
          data-price-save
          {% if save_pct == 0 %}hidden{% endif %}
        >Save {{ save_pct }}%</span>
      </div>

      {%- assign point_blocks = section.blocks | where: 'type', 'point' -%}
      {%- if point_blocks.size > 0 -%}
        <ul class="buybox__points">
          {%- for block in point_blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: 'check' %}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_name_lower = option.name | downcase
              assign is_color = false
              if option_name_lower == 'color' or option_name_lower == 'colour'
                assign is_color = true
              endif
              assign option_index = forloop.index0
            -%}
            <fieldset class="option-group" data-option-index="{{ option_index }}">
              <legend class="option-group__label">{{ option.name }}</legend>
              <div class="swatches">
                {%- for value in option.values -%}
                  <label class="swatch">
                    <input
                      type="radio"
                      name="option-{{ option_index }}"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <span class="swatch__chip">
                      {%- if is_color -%}
                        {%- liquid
                          assign chip_color = ''
                          assign pairs = section.settings.swatch_colors | split: ','
                          for pair in pairs
                            assign parts = pair | split: ':'
                            assign key = parts[0] | strip | downcase
                            assign value_lower = value | downcase
                            if key == value_lower
                              assign chip_color = parts[1] | strip
                            endif
                          endfor
                        -%}
                        <span class="swatch__dot" {% if chip_color != '' %}style="--swatch-color: {{ chip_color }}"{% endif %}></span>
                      {%- endif -%}
                      {{ value }}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="option-group">
          <label class="option-group__label" for="Quantity">Quantity</label>
          <div class="qty">
            <button type="button" data-qty-change="down" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-change="up" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
          </div>
        </div>

        {%- comment -%} Honest stock indicator, driven by real inventory {%- endcomment -%}
        {%- liquid
          assign stock_state = 'in'
          if current_variant.available == false
            assign stock_state = 'out'
          elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= threshold
            assign stock_state = 'low'
          endif
        -%}
        <p
          class="stock{% if stock_state == 'low' %} stock--low{% elsif stock_state == 'out' %} stock--out{% endif %}"
          data-stock
          data-text-in="{{ section.settings.stock_in_text | escape }}"
          data-text-low="{{ section.settings.stock_low_text | escape }}"
          data-text-out="{{ section.settings.stock_out_text | escape }}"
        >
          <span class="stock__dot"></span>
          <span data-stock-text>
            {%- if stock_state == 'out' -%}
              {{ section.settings.stock_out_text }}
            {%- elsif stock_state == 'low' -%}
              {{ section.settings.stock_low_text | replace: '[count]', current_variant.inventory_quantity }}
            {%- else -%}
              {{ section.settings.stock_in_text }}
            {%- endif -%}
          </span>
        </p>

        <p class="form-errors" data-form-error hidden></p>

        <div class="buybox__buy-row">
          <button
            type="submit"
            name="add"
            class="btn btn--primary btn--large"
            data-add-to-cart
            data-text-add="{{ section.settings.add_to_cart_label | escape }}"
            data-text-sold-out="Sold out"
            data-adding-text="Adding…"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-atc-label>
              {%- if current_variant.available -%}
                {{ section.settings.add_to_cart_label }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </span>
          </button>
        </div>

        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
      {%- endform -%}

      {%- comment -%} Trust badges under the buy button {%- endcomment -%}
      <div class="badges-row">
        <div class="badge-item">
          {% render 'icon', name: section.settings.badge_1_icon %}
          <span>{{ section.settings.badge_1_text }}</span>
        </div>
        <div class="badge-item">
          {% render 'icon', name: section.settings.badge_2_icon %}
          <span>{{ section.settings.badge_2_text }}</span>
        </div>
        <div class="badge-item">
          {% render 'icon', name: section.settings.badge_3_icon %}
          <span>{{ section.settings.badge_3_text }}</span>
        </div>
      </div>

      {%- comment -%} Expandable detail sections {%- endcomment -%}
      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
      {%- for block in accordion_blocks -%}
        <details class="accordion" {% if forloop.first and section.settings.open_first_accordion %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span class="accordion__icon-title">
              {% render 'icon', name: block.settings.icon %}
              {{ block.settings.heading }}
            </span>
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="accordion__body">
            {{ block.settings.content }}
            {%- if block.settings.show_description -%}
              {{ product.description }}
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} ---------- Sticky add-to-cart bar ---------- {%- endcomment -%}
{%- if section.settings.show_sticky_bar -%}
  <div
    class="sticky-bar{% if section.settings.sticky_mobile_only %} sticky-bar--mobile-only{% endif %}"
    data-sticky-bar
    data-sticky-watch="[data-add-to-cart]"
  >
    <div class="sticky-bar__thumb">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 100 }}" alt="" loading="lazy" width="44" height="44">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="sticky-bar__info">
      <p class="sticky-bar__title">{{ product.title }}</p>
      <span class="sticky-bar__price" data-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button class="btn btn--primary" type="button" data-sticky-atc>
      {{ section.settings.add_to_cart_label }}
    </button>
  </div>
{%- endif -%}

{%- comment -%} ---------- Lightbox ---------- {%- endcomment -%}
<div class="lightbox" id="ProductLightbox" role="dialog" aria-label="Zoomed product image">
  <button class="lightbox__close" type="button" aria-label="Close zoom">
    {% render 'icon', name: 'close' %}
  </button>
  {%- comment -%}theme-check-disable RemoteAsset{%- endcomment -%}
  <img src="" alt="" width="1800" height="1800">
  {%- comment -%}theme-check-enable RemoteAsset{%- endcomment -%}
</div>

{%- comment -%} ---------- Product data for product.js ---------- {%- endcomment -%}
<script type="application/json" data-product-json>
  {
    "lowStockThreshold": {{ threshold }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          "managed": {% if variant.inventory_management != blank %}true{% else %}false{% endif %},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 | json }},
          "featured_media_id": {{ variant.featured_media.id | default: 0 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "header",
      "content": "Rating (shown above title)"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Rating",
      "min": 3,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.8 · 2,300+ reviews"
    },
    {
      "type": "header",
      "content": "Buying"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Buy Now button",
      "info": "Shopify's dynamic checkout button (Shop Pay, PayPal, etc.)",
      "default": true
    },
    {
      "type": "textarea",
      "id": "swatch_colors",
      "label": "Color swatch map",
      "info": "One 'Value:hex' pair per color, comma-separated.",
      "default": "White:#F2EFE9, Grey:#9A9C9B"
    },
    {
      "type": "header",
      "content": "Stock indicator"
    },
    {
      "type": "paragraph",
      "content": "Driven by your real Shopify inventory — no fake scarcity. The low-stock message only shows when tracked inventory is at or below the threshold."
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "text",
      "id": "stock_in_text",
      "label": "In stock text",
      "default": "In stock — ships within 1 business day"
    },
    {
      "type": "text",
      "id": "stock_low_text",
      "label": "Low stock text",
      "info": "Use [count] where the real quantity should appear.",
      "default": "Only [count] left in stock"
    },
    {
      "type": "text",
      "id": "stock_out_text",
      "label": "Sold out text",
      "default": "Sold out — back soon"
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "select",
      "id": "badge_1_icon",
      "label": "Badge 1 icon",
      "options": [
        { "value": "return", "label": "Returns" },
        { "value": "lock", "label": "Lock" },
        { "value": "truck", "label": "Truck" },
        { "value": "shield", "label": "Shield" }
      ],
      "default": "return"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 text",
      "default": "Free 30-day returns"
    },
    {
      "type": "select",
      "id": "badge_2_icon",
      "label": "Badge 2 icon",
      "options": [
        { "value": "return", "label": "Returns" },
        { "value": "lock", "label": "Lock" },
        { "value": "truck", "label": "Truck" },
        { "value": "shield", "label": "Shield" }
      ],
      "default": "lock"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "Secure checkout"
    },
    {
      "type": "select",
      "id": "badge_3_icon",
      "label": "Badge 3 icon",
      "options": [
        { "value": "return", "label": "Returns" },
        { "value": "lock", "label": "Lock" },
        { "value": "truck", "label": "Truck" },
        { "value": "shield", "label": "Shield" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 text",
      "default": "Fast U.S. shipping"
    },
    {
      "type": "header",
      "content": "Detail accordions"
    },
    {
      "type": "checkbox",
      "id": "open_first_accordion",
      "label": "Open the first accordion by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Sticky add-to-cart bar"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_bar",
      "label": "Show sticky bar on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile_only",
      "label": "Sticky bar on mobile only",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Feature bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shiatsu-style deep kneading with 8 heated nodes"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "hand", "label": "How it works" },
            { "value": "box", "label": "Box" },
            { "value": "zap", "label": "Specs" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "check-circle", "label": "Checkmark" }
          ],
          "default": "check-circle"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "How it works"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "label": "Append product description",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
