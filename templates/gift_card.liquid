{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gift card — {{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-tint: {{ settings.color_tint }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_text | color_mix: settings.color_background, 62 }};
        --color-border: {{ settings.color_text | color_mix: settings.color_background, 14 }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-dark: {{ settings.color_accent | color_darken: 8 }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-highlight: {{ settings.color_highlight }};
        --color-highlight-tint: {{ settings.color_highlight | color_mix: settings.color_background, 14 }};
        --color-star: {{ settings.color_star }};
      }
    </style>
  </head>
  <body>
    <div class="container error-page">
      <h1>Your {{ shop.name }} gift card</h1>
      <p style="font-size: 2.4rem; font-weight: 700;">{{ gift_card.balance | money }}</p>
      <p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>
      {%- if gift_card.expired -%}
        <p>This gift card has expired.</p>
      {%- endif -%}
      <a class="btn btn--primary" href="{{ shop.url }}">Start shopping</a>
    </div>
  </body>
</html>
