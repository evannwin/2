<div class="container account-page account-page--wide">
  <h1>Order {{ order.name }}</h1>
  <p>Placed {{ order.created_at | date: '%B %-d, %Y' }} · <a href="{{ routes.account_url }}">Back to account</a></p>

  <table>
    <thead>
      <tr><th>Product</th><th>Qty</th><th>Price</th></tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>{{ line_item.title }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <div style="margin-top: 2rem; max-width: 32rem;">
    <p>Subtotal: {{ order.line_items_subtotal_price | money }}</p>
    {%- for shipping_method in order.shipping_methods -%}
      <p>Shipping ({{ shipping_method.title }}): {{ shipping_method.price | money }}</p>
    {%- endfor -%}
    <p><strong>Total: {{ order.total_price | money }}</strong></p>
  </div>
</div>
